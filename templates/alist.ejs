<%- include('partials/header') %>

<div class="rail-head">
  <h1 class="rail-title"><%= title %></h1>
</div>

<% if (items.length === 0) { %>
  <div class="no-signal"><span>NO SIGNAL</span><p>Feed sedang diperbarui.</p></div>
<% } else { %>
  <div class="a-list">
    <% items.forEach((a) => { %>
      <a class="a-row" href="/anime/<%= a.slug %>"><%= a.title %></a>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>