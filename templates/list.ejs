<%- include('partials/header') %>

<div class="rail-head">
  <h1 class="rail-title"><%= title %></h1>
  <% if (items.length) { %><span class="rail-count"><%= items.length %> TITLES</span><% } %>
</div>

<% if (items.length === 0) { %>
  <div class="no-signal"><span>NO SIGNAL</span><p>Feed sedang diperbarui.</p></div>
<% } else { %>
  <div class="grid">
    <% items.forEach((a) => { %>
      <%- include('partials/tile', { a, eager: false }) %>
    <% }) %>
  </div>
<% } %>

<% if (totalPages > 1) { %>
  <nav class="pagination" aria-label="Pagination">
    <% if (page > 1) { %><a class="btn btn-ghost" href="?page=<%= page - 1 %>">&larr; Prev</a><% } %>
    <span class="page-num"><%= page %> / <%= totalPages %></span>
    <% if (page < totalPages) { %><a class="btn btn-ghost" href="?page=<%= page + 1 %>">Next &rarr;</a><% } %>
  </nav>
<% } %>

<%- include('partials/footer') %>