<%- include('partials/header') %>

<div class="rail-head">
  <h1 class="rail-title">Jadwal Rilis</h1>
</div>

<div class="schedule">
  <% days.forEach((d) => { %>
    <div class="sched-day">
      <h2 class="sched-title"><%= d.day %></h2>
      <ul class="sched-list">
        <% d.items.forEach((it) => { %>
          <li>
            <% if (it.url) { %><a href="/anime/<%= it.url.split('/').filter(Boolean).pop() %>"><%= it.title %></a>
            <% } else { %><span><%= it.title %></span><% } %>
          </li>
        <% }) %>
      </ul>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>