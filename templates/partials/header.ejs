<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · OTAKUDESU CLEAN</title>
  <meta name="description" content="Streaming anime tanpa iklan. Sumber data: otakudesu.blog.">
  <link rel="stylesheet" href="/css/style.css?v=2">
</head>
<body>
  <header class="site-header">
    <div class="wrap header-row">
      <a href="/" class="brand">OTAKUDESU<span> CLEAN</span></a>
      <div class="search" id="search">
        <input type="search" id="search-input" placeholder="Search titles…" aria-label="Search anime" autocomplete="off">
        <div class="search-drop" id="search-drop" hidden></div>
      </div>
    </div>
    <nav class="wrap site-nav" aria-label="Main">
      <% const links = [['/','Home'],['/anime-list/','Anime List'],['/jadwal-rilis/','Jadwal Rilis'],['/ongoing-anime/','On-Going'],['/complete-anime/','Complete'],['/genre-list/','Genre List']]; %>
      <% links.forEach(([href,label]) => { %>
        <a href="<%= href %>" class="<%= active === href ? 'active' : '' %>"><%= label %></a>
      <% }) %>
    </nav>
  </header>
  <main class="wrap page">