<a class="tile" href="<%= a.slug ? '/anime/' + a.slug : a.url %>">
  <span class="tile-cover">
    <% if (a.cover) { %>
      <img src="<%= a.cover %>" alt="<%= a.title %>" loading="<%= eager ? 'eager' : 'lazy' %>" <%= eager ? 'fetchpriority="high"' : '' %>>
    <% } else { %>
      <span class="cover-none">NO COVER</span>
    <% } %>
    <% if (a.episode) { %><span class="tile-badge"><%= a.episode %></span><% } %>
  </span>
  <span class="tile-name"><%= a.title %></span>
  <% if (a.rating) { %><span class="tile-meta"><%= a.rating %></span><% } %>
  <% if (a.status) { %><span class="tile-meta"><%= a.status %></span><% } %>
</a>