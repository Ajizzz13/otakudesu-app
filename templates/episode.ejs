<%- include('partials/header') %>

<% if (ep.streams.length) { %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/artplayer@5/dist/artplayer.css">
<% } %>

<div class="player-shell">
  <div>
    <div class="player-head">
      <h1 class="player-title"><%= ep.title %></h1>
      <nav class="ep-nav" aria-label="Episode navigation">
        <% if (ep.navigation.prev) { %><a class="btn btn-ghost" href="/episode/<%= ep.navigation.prev %>">&larr; Prev</a>
        <% } else { %><span class="btn btn-ghost disabled">Prev</span><% } %>
        <% if (ep.navigation.all) { %><a class="btn btn-ghost" href="/anime/<%= ep.navigation.all %>">All Episodes</a><% } %>
        <% if (ep.navigation.next) { %><a class="btn btn-ghost" href="/episode/<%= ep.navigation.next %>">Next &rarr;</a>
        <% } else { %><span class="btn btn-ghost disabled">Next</span><% } %>
      </nav>
    </div>

    <div class="player" data-player data-default="<%= ep.defaultStreamingUrl %>">
      <div class="player-frame" data-frame>
        <% if (ep.streams.length) { %>
          <div id="art-wrap"></div>
          <script>window.__streams = <%- JSON.stringify(ep.streams) %>;</script>
        <% } else if (ep.defaultStreamingUrl) { %>
          <iframe src="<%= ep.defaultStreamingUrl %>" title="Stream" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
        <% } else { %>
          <div class="player-empty"><span>LOST FEED</span></div>
        <% } %>
      </div>
      <div class="player-loading" data-loading hidden>LOADING FEED…</div>
    </div>

    <% if (groups.length) { %>
      <div class="server-row" role="group" aria-label="Server">
        <% groups.forEach((g) => { %>
          <div class="server-group">
            <label class="server-label" for="server-<%= g.quality.replace(/\W/g, '') %>"><%= g.quality %></label>
            <select class="server-select" id="server-<%= g.quality.replace(/\W/g, '') %>" data-quality="<%= g.quality %>">
              <% g.options.forEach((o) => { %>
                <option value="<%= o.payload %>"><%= o.server %></option>
              <% }) %>
            </select>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (ep.sizes.length) { %>
      <p class="quota">
        <span class="quota-label">EST. QUOTA / EP</span>
        <span class="quota-list"><% ep.sizes.forEach((s) => { %><span><%= s.quality %> ≈ <%= s.size %></span><% }) %></span>
      </p>
    <% } %>
  </div>

  <% if (episodes.length > 0) { %>
    <aside>
      <div class="ep-head-row">
        <h2 class="rail-title">Episodes</h2>
        <span class="rail-count"><%= episodes.length %></span>
      </div>
      <%- include('partials/episode-list', { episodes: episodes.map(e => ({ title: e.title, slug: e.slug, date: e.date })), activeSlug: activeSlug }) %>
    </aside>
  <% } %>
</div>

<% if (ep.streams.length) { %>
  <script src="https://cdn.jsdelivr.net/npm/artplayer@5/dist/artplayer.min.js"></script>
<% } %>

<%- include('partials/footer') %>