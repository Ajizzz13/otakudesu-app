<%- include('partials/header') %>

<div class="rail-head">
  <h1 class="rail-title">Search</h1>
  <span class="rail-count"><%= q ? '“' + q + '”' : '' %></span>
</div>

<div class="search-inline" style="max-width:420px;margin-bottom:28px">
  <input type="search" id="search-page" placeholder="Search titles…" value="<%= q %>" aria-label="Search anime">
</div>

<% if (q.length < 2) { %>
  <div class="no-signal"><span>MIN 2 CHARACTERS</span></div>
<% } else if (items.length === 0) { %>
  <div class="no-signal"><span>NO RESULT</span><p>Coba judul lain.</p></div>
<% } else { %>
  <div class="grid">
    <% items.forEach((a, i) => { %>
      <%- include('partials/tile', { a, eager: i < 8 }) %>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>